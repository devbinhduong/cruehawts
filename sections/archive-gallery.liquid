{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: var(--color-background);
  }

  .archive-gallery-section {
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .archive-gallery-wrapper-{{ section.id }} {
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: 20px;
    padding-right: 20px;
    box-sizing: border-box;
  }

  .archive-gallery-header-{{ section.id }} {
    text-align: center;
    margin-bottom: 36px;
  }

  .archive-gallery-title-{{ section.id }} {
    font-family: var(--font-body--family), 'Courier New', Courier, monospace;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-foreground-heading, var(--color-foreground));
    margin: 0;
    display: inline-block;
  }

  .archive-gallery-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    column-gap: {{ section.settings.gap }}px;
    row-gap: {{ section.settings.gap | plus: 16 }}px;
  }

  .archive-card,
  .archive-card:hover,
  .archive-card:focus,
  .archive-card:active {
    display: flex;
    flex-direction: column;
    text-decoration: none !important;
    text-decoration-line: none !important;
    color: inherit !important;
    background-image: none !important;
    border: none !important;
    border-bottom: none !important;
    box-shadow: none !important;
    outline: none !important;
    transition: opacity 0.25s ease;
  }

  .archive-card:hover {
    opacity: 0.88;
  }

  .archive-card *,
  .archive-card:hover *,
  .archive-card-caption-{{ section.id }} {
    text-decoration: none !important;
    text-decoration-line: none !important;
    background-image: none !important;
    border-bottom: none !important;
    box-shadow: none !important;
  }

  .archive-card-image-wrap {
    width: 100%;
    position: relative;
    overflow: hidden;
    background-color: rgba(var(--color-foreground-rgb) / var(--opacity-5-15, 0.08));
  }

  .archive-card-image {
    width: 100%;
    height: 100%;
    display: block;
    {% if section.settings.image_ratio != 'adapt' %}
      object-fit: cover;
    {% else %}
      height: auto;
      object-fit: contain;
    {% endif %}
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .archive-card:hover .archive-card-image,
  .archive-card:hover .archive-placeholder-svg {
    transform: scale(1.02);
  }

  .archive-card-placeholder {
    width: 100%;
    height: 100%;
    min-height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(var(--color-foreground-rgb) / var(--opacity-10-25, 0.1));
  }

  .archive-placeholder-svg {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .archive-card-caption-{{ section.id }} {
    font-family: var(--font-body--family), 'Courier New', Courier, monospace;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-foreground);
    margin-top: 10px;
    margin-bottom: 0;
    line-height: 1.4;
    word-break: break-word;
  }

  @media screen and (max-width: 989px) {
    .archive-gallery-grid-{{ section.id }} {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 16px;
      row-gap: 24px;
    }
  }

  @media screen and (max-width: 640px) {
    .archive-gallery-grid-{{ section.id }} {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      column-gap: 12px;
      row-gap: 20px;
    }
    .archive-gallery-wrapper-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | divided_by: 1.5 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 1.5 | round }}px;
      padding-left: 12px;
      padding-right: 12px;
    }
    .archive-gallery-header-{{ section.id }} {
      margin-bottom: 24px;
    }
  }
{%- endstyle -%}

<div class="archive-gallery-section color-{{ section.settings.color_scheme }}">
  <div class="archive-gallery-wrapper-{{ section.id }}">
    {%- if section.settings.title != blank -%}
      <div class="archive-gallery-header-{{ section.id }}">
        <h1 class="archive-gallery-title-{{ section.id }}">{{ section.settings.title }}</h1>
      </div>
    {%- endif -%}

    <div class="archive-gallery-grid-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_tag = 'div'
          if block.settings.link != blank
            assign card_tag = 'a'
          endif

          assign ratio = section.settings.image_ratio
        -%}

        <{{ card_tag }}
          {% if block.settings.link != blank %}
            href="{{ block.settings.link }}"
            {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
          {% endif %}
          class="archive-card"
          {{ block.shopify_attributes }}
        >
          <div
            class="archive-card-image-wrap"
            style="
              {%- if ratio == 'portrait' -%}
                aspect-ratio: 4 / 5;
              {%- elsif ratio == 'square' -%}
                aspect-ratio: 1 / 1;
              {%- elsif ratio == 'landscape' -%}
                aspect-ratio: 16 / 9;
              {%- elsif block.settings.image != blank -%}
                aspect-ratio: {{ block.settings.image.aspect_ratio }};
              {%- else -%}
                aspect-ratio: 4 / 5;
              {%- endif -%}
            "
          >
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1400
                | image_tag:
                  loading: 'lazy',
                  class: 'archive-card-image',
                  widths: '360, 540, 720, 900, 1080, 1400',
                  sizes: '(min-width: 990px) 33vw, (min-width: 640px) 50vw, 100vw'
              }}
            {%- else -%}
              <div class="archive-card-placeholder">
                {%- assign placeholder_index = forloop.index0 | modulo: 3 | plus: 1 -%}
                {%- assign placeholder_name = 'hero-apparel-' | append: placeholder_index -%}
                {{ placeholder_name | placeholder_svg_tag: 'archive-placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>

          {%- if block.settings.caption != blank -%}
            <p class="archive-card-caption-{{ section.id }}">
              {{ block.settings.caption }}
            </p>
          {%- endif -%}
        </{{ card_tag }}>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Archive Gallery",
  "tag": "section",
  "class": "section-archive-gallery",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "ARCHIVE"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on Desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on Mobile",
      "options": [
        {
          "value": "1",
          "label": "1 Column"
        },
        {
          "value": "2",
          "label": "2 Columns"
        }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "portrait",
          "label": "Portrait (4:5)"
        },
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "landscape",
          "label": "Landscape (16:9)"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Grid Gap",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Container Max Width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Archive Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption Text",
          "default": "R419 MYSTIQUE"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Banner Link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Archive Gallery",
      "blocks": [
        {
          "type": "banner",
          "settings": {
            "caption": "R419 MYSTIQUE"
          }
        },
        {
          "type": "banner",
          "settings": {
            "caption": "23.10.26"
          }
        },
        {
          "type": "banner",
          "settings": {
            "caption": "HOW TO MAKE AN ADVERT [R419]"
          }
        },
        {
          "type": "banner",
          "settings": {
            "caption": "OCTOBER 2026 [LOOK 1]"
          }
        },
        {
          "type": "banner",
          "settings": {
            "caption": "OCTOBER 2026 [LOOK 2]"
          }
        },
        {
          "type": "banner",
          "settings": {
            "caption": "OCTOBER 2026 [LOOK 3]"
          }
        }
      ]
    }
  ]
}
{% endschema %}
