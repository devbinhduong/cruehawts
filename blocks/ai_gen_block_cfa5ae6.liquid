    Design style:
    
    Clean, modern, minimal — matching Horizon theme style.
    
    Default: 4 cards in a 2x2 grid with icons centered.
    
    Cards should expand equally in row width.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-why-choose-us-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-why-choose-us-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-why-choose-us-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.vertical_spacing }}px {{ block.settings.horizontal_spacing }}px;
    {% if block.settings.card_alignment == 'center' %}
      justify-items: center;
    {% elsif block.settings.card_alignment == 'left' %}
      justify-items: start;
    {% else %}
      justify-items: stretch;
    {% endif %}
  }

  .ai-why-choose-us-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    {% if block.settings.card_size == 'small' %}
      padding: 24px;
    {% elsif block.settings.card_size == 'medium' %}
      padding: 32px;
    {% else %}
      padding: 40px;
    {% endif %}
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    {% if block.settings.card_alignment == 'justified' %}
      width: 100%;
    {% else %}
      max-width: 400px;
    {% endif %}
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.05);
  }

  {% if block.settings.hover_animation == 'lift' %}
    .ai-why-choose-us-card-{{ ai_gen_id }}:hover {
      transform: translateY(-8px);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
    }
  {% elsif block.settings.hover_animation == 'shadow' %}
    .ai-why-choose-us-card-{{ ai_gen_id }}:hover {
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
    }
  {% endif %}

  .ai-why-choose-us-icon-{{ ai_gen_id }} {
    margin-bottom: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ai-why-choose-us-icon-{{ ai_gen_id }} img {
    {% if block.settings.card_size == 'small' %}
      width: 48px;
      height: 48px;
    {% elsif block.settings.card_size == 'medium' %}
      width: 64px;
      height: 64px;
    {% else %}
      width: 80px;
      height: 80px;
    {% endif %}
    object-fit: contain;
  }

  .ai-why-choose-us-icon-placeholder-{{ ai_gen_id }} {
    {% if block.settings.card_size == 'small' %}
      width: 48px;
      height: 48px;
    {% elsif block.settings.card_size == 'medium' %}
      width: 64px;
      height: 64px;
    {% else %}
      width: 80px;
      height: 80px;
    {% endif %}
    background-color: #f4f4f4;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
  }

  .ai-why-choose-us-icon-placeholder-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
    color: #999;
  }

  .ai-why-choose-us-title-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0 0 12px;
    font-family: var(--font-heading-family);
    font-weight: 700;
    {% if block.settings.card_size == 'small' %}
      font-size: 18px;
      line-height: 1.3;
    {% elsif block.settings.card_size == 'medium' %}
      font-size: 20px;
      line-height: 1.3;
    {% else %}
      font-size: 24px;
      line-height: 1.2;
    {% endif %}
  }

  .ai-why-choose-us-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0;
    font-family: var(--font-body-family);
    {% if block.settings.card_size == 'small' %}
      font-size: 14px;
      line-height: 1.5;
    {% elsif block.settings.card_size == 'medium' %}
      font-size: 15px;
      line-height: 1.5;
    {% else %}
      font-size: 16px;
      line-height: 1.6;
    {% endif %}
    opacity: 0.85;
  }

  .ai-why-choose-us-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
  }

  .ai-why-choose-us-card-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    pointer-events: none;
  }

  .ai-why-choose-us-card-{{ ai_gen_id }}:has(.ai-why-choose-us-link-{{ ai_gen_id }}) {
    cursor: pointer;
  }

  @media screen and (max-width: 768px) {
    .ai-why-choose-us-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.vertical_spacing | times: 0.75 }}px {{ block.settings.horizontal_spacing | times: 0.75 }}px;
    }

    .ai-why-choose-us-card-{{ ai_gen_id }} {
      padding: 24px 20px;
    }

    .ai-why-choose-us-title-{{ ai_gen_id }} {
      font-size: 18px;
    }

    .ai-why-choose-us-description-{{ ai_gen_id }} {
      font-size: 14px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-why-choose-us-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

