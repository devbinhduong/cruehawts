{% doc %}
  @prompt
    Create a horizontal content list section with 3 items that can be customized with titles, descriptions, and optional images or icons
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-content-list-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-content-list-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-content-list-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.item_spacing }}px;
    align-items: start;
  }

  .ai-content-list-item-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background_color }};
    border-radius: {{ block.settings.item_border_radius }}px;
    border: {{ block.settings.item_border_width }}px solid {{ block.settings.item_border_color }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  {% if block.settings.enable_hover_effect %}
    .ai-content-list-item-{{ ai_gen_id }}:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
    }
  {% endif %}

  .ai-content-list-image-wrapper-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.image_spacing }}px;
    display: flex;
    justify-content: center;
  }

  .ai-content-list-image-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    object-fit: cover;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-content-list-image-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-content-list-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-content-list-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: {{ block.settings.title_font_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    line-height: 1.3;
  }

  .ai-content-list-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.5;
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .ai-content-list-grid-{{ ai_gen_id }} {
      grid-template-columns: {% if block.settings.columns_mobile == "1" %}1fr{% else %}repeat(2, 1fr){% endif %};
      gap: {{ block.settings.item_spacing | times: 0.75 }}px;
    }

    .ai-content-list-item-{{ ai_gen_id }} {
      padding: {{ block.settings.item_padding | times: 0.75 }}px;
    }

    .ai-content-list-image-{{ ai_gen_id }},
    .ai-content-list-image-placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.image_size | times: 0.8 }}px;
      height: {{ block.settings.image_size | times: 0.8 }}px;
    }

    .ai-content-list-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.9 }}px;
    }

    .ai-content-list-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-content-list-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-content-list-container-{{ ai_gen_id }}">
    <div class="ai-content-list-grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign title_key = 'item_' | append: i | append: '_title'
          assign description_key = 'item_' | append: i | append: '_description'
          assign image_key = 'item_' | append: i | append: '_image'
          
          assign item_title = block.settings[title_key]
          assign item_description = block.settings[description_key]
          assign item_image = block.settings[image_key]
        %}
        
        <div class="ai-content-list-item-{{ ai_gen_id }}">
          {% if item_image != blank %}
            <div class="ai-content-list-image-wrapper-{{ ai_gen_id }}">
              <img
                src="{{ item_image | image_url: width: 400 }}"
                alt="{{ item_image.alt | escape }}"
                class="ai-content-list-image-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ block.settings.image_size }}"
                height="{{ block.settings.image_size }}"
              >
            </div>
          {% else %}
            <div class="ai-content-list-image-wrapper-{{ ai_gen_id }}">
              <div class="ai-content-list-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            </div>
          {% endif %}

          {% if item_title != blank %}
            <h3 class="ai-content-list-title-{{ ai_gen_id }}">{{ item_title }}</h3>
          {% endif %}

          {% if item_description != blank %}
            <div class="ai-content-list-description-{{ ai_gen_id }}">{{ item_description }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

