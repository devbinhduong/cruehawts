{% doc %}
  @prompt
    Create a 'Why Choose Us' section with four benefit cards arranged in a 2x2 grid on desktop and stacked vertically on mobile. Each card should have a custom icon (with icon selection or upload option), a bold benefit title, and a brief supporting description. Include proper spacing and hover effects for better user experience., add more card funtion, 4 cards placed horizontally, add more card funtion, 4 cards placed horizontally
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-why-choose-us-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-why-choose-us-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-why-choose-us-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-why-choose-us-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .ai-why-choose-us-subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.subtitle_color }};
    font-size: {{ block.settings.subtitle_size }}px;
    margin: 0;
    line-height: 1.5;
  }

  .ai-why-choose-us-grid-{{ ai_gen_id }} {
    display: grid;
    gap: {{ block.settings.card_spacing }}px;
    margin-top: {{ block.settings.grid_spacing }}px;
    {% if block.settings.layout == 'horizontal' %}
      grid-template-columns: repeat({{ block.settings.cards_per_row }}, 1fr);
    {% else %}
      grid-template-columns: repeat(2, 1fr);
    {% endif %}
  }

  .ai-why-choose-us-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    text-align: center;
    transition: all 0.3s ease;
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    box-shadow: {{ block.settings.card_shadow_horizontal }}px {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px {{ block.settings.card_shadow_color }};
  }

  .ai-why-choose-us-card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: {{ block.settings.card_shadow_horizontal }}px {{ block.settings.card_shadow_vertical | plus: block.settings.hover_lift }}px {{ block.settings.card_shadow_blur | plus: 5 }}px {{ block.settings.card_shadow_color }};
  }

  .ai-why-choose-us-icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto {{ block.settings.icon_spacing }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_background_color }};
    border-radius: {{ block.settings.icon_border_radius }}px;
  }

  .ai-why-choose-us-icon-wrapper-{{ ai_gen_id }} img {
    width: {{ block.settings.icon_size | times: 0.6 }}px;
    height: {{ block.settings.icon_size | times: 0.6 }}px;
    object-fit: contain;
  }

  .ai-why-choose-us-icon-wrapper-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size | times: 0.6 }}px;
    height: {{ block.settings.icon_size | times: 0.6 }}px;
    fill: {{ block.settings.icon_color }};
  }

  .ai-why-choose-us-card-title-{{ ai_gen_id }} {
    color: {{ block.settings.card_title_color }};
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 700;
    margin: 0 0 {{ block.settings.title_spacing }}px;
    line-height: 1.3;
  }

  .ai-why-choose-us-card-description-{{ ai_gen_id }} {
    color: {{ block.settings.card_description_color }};
    font-size: {{ block.settings.card_description_size }}px;
    line-height: 1.5;
    margin: 0;
  }

  @media screen and (max-width: 1024px) {
    .ai-why-choose-us-grid-{{ ai_gen_id }} {
      {% if block.settings.layout == 'horizontal' %}
        grid-template-columns: repeat({{ block.settings.tablet_cards_per_row }}, 1fr);
      {% endif %}
    }
  }

  @media screen and (max-width: 768px) {
    .ai-why-choose-us-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.mobile_cards_per_row }}, 1fr);
      gap: {{ block.settings.mobile_card_spacing }}px;
    }

    .ai-why-choose-us-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_section_padding }}px 0;
    }

    .ai-why-choose-us-container-{{ ai_gen_id }} {
      padding: 0 16px;
    }

    .ai-why-choose-us-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_title_size }}px;
    }

    .ai-why-choose-us-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_subtitle_size }}px;
    }

    .ai-why-choose-us-card-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_card_padding }}px;
    }

    .ai-why-choose-us-icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_icon_size }}px;
      height: {{ block.settings.mobile_icon_size }}px;
    }

    .ai-why-choose-us-icon-wrapper-{{ ai_gen_id }} img,
    .ai-why-choose-us-icon-wrapper-{{ ai_gen_id }} svg {
      width: {{ block.settings.mobile_icon_size | times: 0.6 }}px;
      height: {{ block.settings.mobile_icon_size | times: 0.6 }}px;
    }

    .ai-why-choose-us-card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_card_title_size }}px;
    }

    .ai-why-choose-us-card-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_card_description_size }}px;
    }
  }
{% endstyle %}

<div class="ai-why-choose-us-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-why-choose-us-container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank or block.settings.section_subtitle != blank %}
      <div class="ai-why-choose-us-header-{{ ai_gen_id }}">
        {% if block.settings.section_title != blank %}
          <h2 class="ai-why-choose-us-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
        {% endif %}
        {% if block.settings.section_subtitle != blank %}
          <p class="ai-why-choose-us-subtitle-{{ ai_gen_id }}">{{ block.settings.section_subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-why-choose-us-grid-{{ ai_gen_id }}">
      {% for i in (1..8) %}
        {% liquid
          assign card_enabled_key = 'card_' | append: i | append: '_enabled'
          assign card_title_key = 'card_' | append: i | append: '_title'
          assign card_description_key = 'card_' | append: i | append: '_description'
          assign card_icon_key = 'card_' | append: i | append: '_icon'
          assign card_icon_type_key = 'card_' | append: i | append: '_icon_type'

          assign card_enabled = block.settings[card_enabled_key]
          assign card_title = block.settings[card_title_key]
          assign card_description = block.settings[card_description_key]
          assign card_icon = block.settings[card_icon_key]
          assign card_icon_type = block.settings[card_icon_type_key]
        %}

        {% if card_enabled %}
          <div class="ai-why-choose-us-card-{{ ai_gen_id }}">
            <div class="ai-why-choose-us-icon-wrapper-{{ ai_gen_id }}">
              {% if card_icon_type == 'upload' and card_icon != blank %}
                <img
                  src="{{ card_icon | image_url: width: 100 }}"
                  alt="{{ card_title | escape }}"
                  loading="lazy"
                  width="100"
                  height="100"
                >
              {% elsif card_icon_type == 'preset' %}
                {% case i %}
                  {% when 1 %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M9 12l2 2 4-4"/>
                      <path d="M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9z"/>
                    </svg>
                  {% when 2 %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                  {% when 3 %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                    </svg>
                  {% when 4 %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                    </svg>
                  {% when 5 %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                  {% when 6 %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"/>
                      <polyline points="12,6 12,12 16,14"/>
                    </svg>
                  {% when 7 %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                      <polyline points="3.27,6.96 12,12.01 20.73,6.96"/>
                      <line x1="12" y1="22.08" x2="12" y2="12"/>
                    </svg>
                  {% when 8 %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/>
                    </svg>
                {% endcase %}
              {% else %}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 12l2 2 4-4"/>
                  <path d="M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9z"/>
                </svg>
              {% endif %}
            </div>

            {% if card_title != blank %}
              <h3 class="ai-why-choose-us-card-title-{{ ai_gen_id }}">{{ card_title }}</h3>
            {% endif %}

            {% if card_description != blank %}
              <p class="ai-why-choose-us-card-description-{{ ai_gen_id }}">{{ card_description }}</p>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

